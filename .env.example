OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/USER_ID/TOKEN/
# ВАЖНО: скоуп вебхука должен включать user (или user_basic) — user_brief не отдаёт
# email сотрудников, и «Пригласить {email}» никого не найдёт.

# Onboarding system
BOT_ID=54849                  # Employee bot ID (numeric)
HR_BOT_ID=                    # HR bot ID — register second bot in Bitrix24, paste ID here
HR_USER_IDS=123,456           # Comma-separated Bitrix user IDs with HR rights
                              # (гейт /hr: пусто = команды доступны всем, только для dev)
                              # Эти же ID автоматически попадают в whitelist
                              # employee-бота (тестировщики, сид в init_db)
MONITOR_FOLDER_ID=789         # Общая папка Bitrix Disk (документы → роль all_staff).
                              # №11: роли документа берутся из ПРЕФИКСОВ в имени файла
                              # («FO, RES Название.docx», реестр data/roles.json prefixes);
                              # фолбэк — ролевые папки (folder_id → роль) там же
WATCH_DEPARTMENT_IDS=         # ID отделов: авто-обнаружение новых сотрудников/переводов
                              # (пусто = поллер отделов выключен)
USER_POLL_INTERVAL_SEC=600    # период опроса отделов, сек
